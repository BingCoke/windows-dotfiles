+    #[test]
+    fn dingtalk_popup_roles() {
+        let win_types = WindowTypes::new();
+        let motif_hints = motif::Hints::from([0x2_u32, 0x1, 0, 0, 0].as_slice());
+
+        let menu = WindowRoleHeuristics {
+            window_types: vec![win_types.utility, win_types.normal],
+            motif_wm_hints: Some(motif_hints),
+            wm_class: Some(WindowRoleHeuristics::DINGTALK_WM_CLASS.into()),
+            ..Default::default()
+        };
+        assert_eq!(menu.guess_window_role(&win_types), WindowRole::Popup);
+
+        let fixed_size = WmNormalHints::new().min_size(643, 418).max_size(643, 418);
+        let expression_panel = WindowRoleHeuristics {
+            window_types: vec![win_types.normal],
+            motif_wm_hints: Some(motif_hints),
+            wm_class: Some(WindowRoleHeuristics::DINGTALK_WM_CLASS.into()),
+            wm_normal_hints: Some(fixed_size.into()),
+            ..Default::default()
+        };
+        assert_eq!(
+            expression_panel.guess_window_role(&win_types),
+            WindowRole::Popup
+        );
+
+        let resizable = WmNormalHints::new().min_size(1229, 750);
+        let main_window = WindowRoleHeuristics {
+            window_types: vec![win_types.normal],
+            motif_wm_hints: Some(motif_hints),
+            wm_class: Some(WindowRoleHeuristics::DINGTALK_WM_CLASS.into()),
+            wm_normal_hints: Some(resizable.into()),
+            ..Default::default()
+        };
+        assert_eq!(
+            main_window.guess_window_role(&win_types),
+            WindowRole::Toplevel
+        );
+
+        let image_view = WindowRoleHeuristics {
+            window_types: vec![win_types.normal],
+            motif_wm_hints: Some(motif_hints),
+            wm_class: Some(WindowRoleHeuristics::DINGTALK_WM_CLASS.into()),
+            ..Default::default()
+        };
+        assert_eq!(
+            image_view.guess_window_role(&win_types),
+            WindowRole::Toplevel
+        );
+    }
